##########################################################################
# TASKSMART PRO - ENV FILE (LOCAL DEVELOPMENT)
# Usado pelo docker-compose.yml localizado em /infra
# Nenhuma credencial real ou sensível deve ser usada em produção
##########################################################################

#############################
# AUTH-SERVICE DB
#############################
AUTH_DB_USER=auth
AUTH_DB_PASS=auth123
AUTH_DB_NAME=auth_db

#############################
# TENANT-SERVICE DB
#############################
TENANT_DB_USER=tenant
TENANT_DB_PASS=tenant123
TENANT_DB_NAME=tenants_db

#############################
# WORKORDER-SERVICE DB
#############################
WORKORDER_DB_USER=workorder
WORKORDER_DB_PASS=work123
WORKORDER_DB_NAME=workorder_db

#############################
# NOTIFICATION-SERVICE DB
#############################
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASS=notif123
NOTIFICATION_DB_NAME=notification_db

#############################
# ASSET-SERVICE DB
#############################
ASSET_DB_USER=asset
ASSET_DB_PASS=asset123
ASSET_DB_NAME=asset_db

#############################
# INVENTORY-SERVICE DB
#############################
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASS=inventory123
INVENTORY_DB_NAME=inventory_db

#############################
# MAINTENANCE-PLAN-SERVICE DB
#############################
MP_DB_USER=maintenance
MP_DB_PASS=maintenance123
MP_DB_NAME=maintenance_plan_db

#############################
# CHECKLIST-SERVICE (MONGO)
#############################
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root123

#############################
# PGADMIN
#############################
PGADMIN_DEFAULT_EMAIL=admin@tasksmart.com
PGADMIN_DEFAULT_PASSWORD=admin123

#############################
# KAFKA / ZOOKEEPER
# (sem variáveis sensíveis)
#############################
KAFKA_BROKER_ID=1
ZOOKEEPER_CLIENT_PORT=2181

#############################
# REDIS (não exige credenciais)
#############################
REDIS_PORT=6379

##########################################################################
# FIM DO ARQUIVO .env
##########################################################################
